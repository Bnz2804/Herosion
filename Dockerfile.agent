# Agent service: FastAPI + Pydantic AI + MCP server (stdio child process) + SQLite on a volume.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends gosu && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 10001 app
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .
COPY docker/agent-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && mkdir /data && chown app /data
ENV EXTENSION_AGENT_DB=/data/extension.sqlite \
    EXTENSION_AGENT_PII_DB=/data/identity.sqlite \
    PYTHONUNBUFFERED=1
VOLUME /data
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz',timeout=3).status==200 else 1)"
ENTRYPOINT ["/entrypoint.sh"]
