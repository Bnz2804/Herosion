# --- agent service (Python) ---
EXTENSION_AGENT_DB=./data/extension.sqlite
EXTENSION_AGENT_MODEL=mistral:mistral-large-latest   # or ollama:mistral-nemo (open-weight, local)
MISTRAL_API_KEY=
