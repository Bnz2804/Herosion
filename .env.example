# ---- Coolify / docker-compose.coolify.yml (set these in Coolify's Environment tab) ----
POSTGRES_PASSWORD=             # required: strong password
AGENT_SERVICE_TOKEN=           # required: long random string (web <-> agent shared secret)
APP_BASIC_AUTH=                # required: user:password (login prompt for the whole app)
MISTRAL_API_KEY=               # needed for agent runs (or use an Ollama URL/model instead)
EXTENSION_AGENT_MODEL=mistral:mistral-large-latest
SEED_SYNTHETIC=true            # first boot loads SYNTHETIC demo data; never overwrites an existing database
PSEUDONYM_SALT=                # secret salt for farmer pseudonyms (set before any real import; never change after)
MAX_AGENT_RUNS_PER_HOUR=30     # cost guard on the model API

# ---- local development (scripts/dev.sh) ----
EXTENSION_AGENT_DB=./data/extension.sqlite
DATABASE_URL=postgres://user:pw@127.0.0.1:5432/herosion
AGENT_SERVICE_URL=http://127.0.0.1:8000
PORT=5000
